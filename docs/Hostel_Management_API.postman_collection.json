{
  "info": {
    "name": "Sharda University Agra - Hostel Management API",
    "_postman_id": "sharda-hms-api-collection-2026",
    "description": "Comprehensive Automated REST API Test Suite for Sharda University Agra Hostel Management System. Tested across 10 modules covering Auth, Students, Hostels, Rooms, Attendance, Leave Passes, Visitor Registry, Complaints, Fees, and Notices.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. System Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Server is running smoothly\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.message).to.include(\"Hostel Management System API\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "02. Auth - Student Login (Ayush 25ASETCSE019)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login successful with 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"JWT Token received and saved to environment\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data.token).to.not.be.empty;",
              "    pm.collectionVariables.set(\"authToken\", jsonData.data.token);",
              "    if (jsonData.data.user.student) {",
              "        pm.collectionVariables.set(\"studentId\", jsonData.data.user.student._id);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ayush@sharda.ac.in\",\n  \"password\": \"ayush123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "03. Auth - Get Current User Profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Returns Student profile for Ayush\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.user.name).to.eql(\"Ayush\");",
              "    pm.expect(jsonData.data.user.role).to.eql(\"student\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "me"]
        }
      }
    },
    {
      "name": "04. Hostels - Get All Hostel Blocks",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Returns hostel blocks list\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.be.an(\"array\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/hostels",
          "host": ["{{baseUrl}}"],
          "path": ["hostels"]
        }
      }
    },
    {
      "name": "05. Rooms - Get Room Inventory",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Returns rooms array with capacity & occupancy\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.be.an(\"array\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/rooms",
          "host": ["{{baseUrl}}"],
          "path": ["rooms"]
        }
      }
    },
    {
      "name": "06. Notices - Get Active Campus Notices",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Returns active notice bulletins\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.be.an(\"array\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/notices",
          "host": ["{{baseUrl}}"],
          "path": ["notices"]
        }
      }
    },
    {
      "name": "07. Complaints - Lodge Maintenance Ticket",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Ticket lodged with 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Complaint has status pending\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.status).to.eql(\"pending\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"electrical\",\n  \"subject\": \"Ceiling Fan Regulator Malfunction\",\n  \"description\": \"The speed regulator in Room 204 is stuck on speed 5.\",\n  \"priority\": \"medium\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/complaints",
          "host": ["{{baseUrl}}"],
          "path": ["complaints"]
        }
      }
    },
    {
      "name": "08. Leave - Apply Outstation Gate Pass",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Leave application created with 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Status defaults to pending\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.status).to.eql(\"pending\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startDate\": \"2026-09-25T09:00:00.000Z\",\n  \"endDate\": \"2026-09-27T18:00:00.000Z\",\n  \"reason\": \"Family function in Agra\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/leave",
          "host": ["{{baseUrl}}"],
          "path": ["leave"]
        }
      }
    },
